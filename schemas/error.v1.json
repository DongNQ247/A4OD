{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error.v1.json",
  "title": "A4OD Error",
  "type": "object",
  "required": ["ok", "status", "error"],
  "properties": {
    "ok": {"const": false},
    "status": {"const": "error"},
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "details": {"type": "object"},
        "suggested_recovery": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
